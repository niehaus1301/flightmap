# Mapbox GL JS access token (client-exposed via Vite)
VITE_MAPBOX_TOKEN=pk.your_mapbox_access_token_here

# Mapbox style URL, e.g. mapbox://styles/mapbox/streets-v12
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

# FlightAware AeroAPI key (used by scripts/enrichFromAeroAPI.ts and debug scripts)
AEROAPI_KEY=your_aeroapi_key_here

# Optional: max flights to process when enriching from AeroAPI (default 50)
MAX_FLIGHTS=50
